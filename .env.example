# Local development (docs/development.md). Start the services first:
#   docker compose -f compose.dev.yaml up -d
DJANGO_DEBUG=1
DEPLOYMENT_ENV=development
DATABASE_URL=postgresql://iam:iam@localhost:55438/iam
# Sign-in with the development Keycloak (realm "iam", user admin@example.invalid / admin).
KEYCLOAK_URL=http://localhost:8098
KEYCLOAK_REALM=iam
OIDC_CLIENT_ID=iam
OIDC_CLIENT_SECRET=iam-dev-client-secret
# Members of this Keycloak group become admins at sign-in.
OIDC_ADMIN_GROUPS=/iam/admins
OIDC_APPROVER_GROUPS=/iam/approvers
# Development sign-in without Keycloak (DJANGO_DEBUG=1 only).
# DEV_LOGIN=1
# Read-only mode: read connected apps, change nothing in them, send no email.
# READ_ONLY=1
# In-app updates (docs/updates.md): the updater the admins' update button talks
# to. Empty here: no update button. Without the line: http://updater:8080.
# (compose.yaml replaces an empty value with http://updater:8080.)
UPDATER_URL=

# Meldgrove Backups (docs/deployment.md#backups): the two lines Backups shows
# when the app is added as a source. Without them, the backup agent idles.
# BACKUP_URL=https://backups.example.invalid
# BACKUP_TOKEN=
