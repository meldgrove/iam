# Settings for the CI job "Compose files of the newest release"
# (.github/workflows/ci.yml): what a server of the newest release has in its
# .env. Fake values only; this file is public. The job sets IAM_VERSION and
# COMPOSE_FILE itself.
APP_URL=https://iam.example.invalid
AUTH_SECRET=compat-only-not-a-secret-compat-only-not-a-secret
# A server upgraded from the Django version (0.2) keeps these two. Docker
# Compose 2.x (the GitHub runner's) needs them even while APP_URL and
# AUTH_SECRET are set: it checks the inner ${...:?} of
# ${APP_URL:-${CSRF_TRUSTED_ORIGINS:?...}} too. Compose 5 does not. The
# compose files on main have no :? inside the fallbacks: remove these two once
# a release after 0.3.2 has them on stable.
CSRF_TRUSTED_ORIGINS=https://iam.example.invalid
DJANGO_SECRET_KEY=compat-only-not-a-secret-compat-only-not-a-secret
ENCRYPTION_KEY=Y29tcGF0LW9ubHktbm90LWEtc2VjcmV0LWtleS0wMDE=
POSTGRES_PASSWORD=compat-only-password
DATABASE_URL=postgres://iam:compat-only-password@postgres:5432/iam
HEALTHCHECK_TOKEN=compat-only-health-token
OIDC_ISSUER=https://sso.example.invalid/realms/iam
OIDC_CLIENT_ID=iam
OIDC_CLIENT_SECRET=compat-only
